<?xml version="1.0" encoding="utf-8"?>
<!-- Text roles from DESIGN.md, "Typography". Each role inherits TextAppearance.DeviceDefault by name, so
     setTextAppearance keeps the theme's font family instead of resetting it to the platform default. -->
<resources>
    <style name="TextAppearance.DataBar" parent="@android:style/TextAppearance.DeviceDefault" />
    <style name="TextAppearance.DataBar.Header">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
    <style name="TextAppearance.DataBar.Total">
        <item name="android:textSize">48sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <style name="TextAppearance.DataBar.Unit">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
    <style name="TextAppearance.DataBar.Summary">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
    <style name="TextAppearance.DataBar.BlockTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <style name="TextAppearance.DataBar.Row">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <style name="TextAppearance.DataBar.Value" parent="TextAppearance.DataBar.Summary" />
    <style name="TextAppearance.DataBar.Chip">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
    <style name="TextAppearance.DataBar.AppName" parent="TextAppearance.DataBar.Row" />
    <style name="TextAppearance.DataBar.Traffic">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <style name="TextAppearance.DataBar.WidgetTitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/widget_title</item>
    </style>
    <style name="TextAppearance.DataBar.WidgetApp">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <style name="TextAppearance.DataBar.WidgetUpload">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
    <style name="TextAppearance.DataBar.WidgetRatio">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/signal</item>
    </style>
    <style name="TextAppearance.DataBar.WidgetMessage">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
    <style name="TextAppearance.DataBar.Baseline">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <!-- The widget tile. clipToOutline rounds its content, and tells the launcher that the tile rounds its
         own corners, so the launcher does not clip the widget to the tile and cut off the title. -->
    <style name="Widget.DataBar.Tile" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/widget_bg</item>
        <item name="android:padding">@dimen/widget_padding</item>
        <item name="android:clipToOutline">true</item>
    </style>
    <style name="Widget.DataBar.Title" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/widget_title_gap</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:text">@string/app_name</item>
        <item name="android:textAppearance">@style/TextAppearance.DataBar.WidgetTitle</item>
    </style>

    <!-- A row of Flagged apps (DESIGN.md, "Widgets"), shared by the widget and its picker preview. -->
    <style name="Widget.DataBar.FlagRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/widget_row</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="Widget.DataBar.FlagIcon" parent="">
        <item name="android:layout_width">@dimen/widget_icon</item>
        <item name="android:layout_height">@dimen/widget_icon</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="Widget.DataBar.FlagName" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">@style/TextAppearance.DataBar.WidgetApp</item>
    </style>
    <style name="Widget.DataBar.FlagUpload" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">@style/TextAppearance.DataBar.WidgetUpload</item>
    </style>
    <style name="Widget.DataBar.FlagRatio" parent="Widget.DataBar.FlagUpload">
        <item name="android:textAppearance">@style/TextAppearance.DataBar.WidgetRatio</item>
    </style>
</resources>
