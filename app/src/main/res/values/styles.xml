<?xml version="1.0" encoding="utf-8"?>
<!-- Text roles from DESIGN.md, "Typography". No font family: the phone's own font. -->
<resources>
    <style name="TextAppearance.DataBar.Header" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
    <style name="TextAppearance.DataBar.Total" parent="">
        <item name="android:textSize">48sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <style name="TextAppearance.DataBar.Unit" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
    <style name="TextAppearance.DataBar.Summary" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
    <style name="TextAppearance.DataBar.BlockTitle" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <style name="TextAppearance.DataBar.Row" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <style name="TextAppearance.DataBar.Value" parent="TextAppearance.DataBar.Summary" />
    <style name="TextAppearance.DataBar.Chip" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
    <style name="TextAppearance.DataBar.AppName" parent="TextAppearance.DataBar.Row" />
    <style name="TextAppearance.DataBar.Traffic" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <style name="TextAppearance.DataBar.Baseline" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
</resources>
