<?xml version="1.0" encoding="utf-8"?>
<!-- The tile and the title below it. The tile holds either the rows of flagged apps or one message. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:theme="@android:style/Theme.DeviceDefault.DayNight">

    <FrameLayout
        android:id="@android:id/background"
        style="@style/Widget.DataBar.Tile">

        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.DataBar.WidgetMessage"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        style="@style/Widget.DataBar.Title" />
</LinearLayout>
