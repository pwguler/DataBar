<?xml version="1.0" encoding="utf-8"?>
<!-- The variable font defaults to ROND 0, square dots; DESIGN.md wants round dots. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/doto_variable"
        android:fontStyle="normal"
        android:fontWeight="900"
        android:fontVariationSettings="'ROND' 100, 'wght' 900" />
</font-family>
