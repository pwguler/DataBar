<?xml version="1.0" encoding="utf-8"?>
<!-- Switch sizes its track from the thumb: a 20 x 22dp thumb with no padding or optical insets gives the
     40 x 22dp track. The dot sits in a layer-list; an InsetDrawable's insets would count as padding and
     optical insets, and Switch would shrink the track by them. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:left="4dp" android:right="4dp" android:top="5dp" android:bottom="5dp">
                <shape android:shape="oval">
                    <size android:width="12dp" android:height="12dp" />
                    <solid android:color="@color/background" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="4dp" android:right="4dp" android:top="5dp" android:bottom="5dp">
                <shape android:shape="oval">
                    <size android:width="12dp" android:height="12dp" />
                    <solid android:color="@color/ink_secondary" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
